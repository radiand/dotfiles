if command -v pyenv &> /dev/null; then
    export PYENV_ROOT="$HOME/.pyenv"
    command -v pyenv >/dev/null || export PATH="$PYENV_ROOT/bin:$PATH"
    eval "$(pyenv init -)"
fi

pipvenv() {
    if [ ! -d './.venv' ]; then
        python3 -m venv .venv
    fi

    . .venv/bin/activate
}

uvvenv() {
    if [ ! -d './.venv' ]; then
        uv venv $@
    fi
    . .venv/bin/activate
}

pyclean() {
    find . -type f -name '*.py[co]' -delete -o -type d -name __pycache__ -delete
}

alias mo='marimo edit --sandbox'
alias tp='tox p -x "testenv.pass_env=UV_NATIVE_TLS"'
